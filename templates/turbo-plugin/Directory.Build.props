<Project>
  <!--
    The plugin builds against a Turbo server's own assemblies, referenced and never copied into the
    plugin's folder. TurboBin is the folder holding them: a turbo-cloud checkout's built server by
    default, or any server's bin folder (-p:TurboBin=... or the TurboBin environment variable).
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TurboCloudPath Condition="'$(TurboCloudPath)' == ''"
      >$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '../turbo-cloud'))))</TurboCloudPath
    >
    <TurboBin Condition="'$(TurboBin)' == ''"
      >$(TurboCloudPath)/Turbo.Main/bin/Debug/net10.0</TurboBin
    >
  </PropertyGroup>
</Project>
