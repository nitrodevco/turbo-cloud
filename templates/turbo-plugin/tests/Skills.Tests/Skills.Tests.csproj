<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../server/Skills.csproj" />
  </ItemGroup>
  <!-- Here the server's assemblies are copied: the tests run without a server. -->
  <ItemGroup>
    <Reference Include="$(TurboBin)/Turbo.Contracts.dll" />
    <Reference Include="$(TurboBin)/Turbo.Primitives.dll" />
    <Reference Include="$(TurboBin)/Orleans.Core.Abstractions.dll" />
    <Reference Include="$(TurboBin)/Orleans.Serialization.Abstractions.dll" />
  </ItemGroup>
</Project>
