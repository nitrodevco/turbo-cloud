<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The plugin's server half: its C# sources, which the hotel compiles as it loads the plugin
    (turbo-cloud docs/plugin-loading.md). This project is for the editor, the tests and `dotnet ef`:
    it builds against what the server compiles plugins with (plugin-sdk/Turbo.Plugin.props: the
    same references, C# version and policy analyzer), so `npm run check` fails as the hotel would.
    `npm run dev` copies the sources into dist/skills/ with the client module and the plugin's
    files, the folder a hotel names in Turbo:Plugin:DevPluginPaths.
  -->
  <Import Project="$(TurboBin)/plugin-sdk/Turbo.Plugin.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Skills</RootNamespace>
    <!-- The hotel's Settings page shows each setting's summary from the doc comments. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
