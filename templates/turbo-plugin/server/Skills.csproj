<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The plugin's server half. `npm run dev` (in the plugin's folder) builds it into dist/skills/
    with the client module and the plugin's files, the folder a hotel names in
    Turbo:Plugin:DevPluginPaths.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Skills</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SelfContained>false</SelfContained>
    <!-- Skills.xml: the admin panel's Settings page shows each setting's summary from it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The plugin folder holds the plugin alone: a host assembly beside it would be a second copy. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.* (services, options, logging) are the shared framework's, as the server's are. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host's own assemblies: referenced, never copied beside the plugin. -->
    <Reference Include="$(TurboBin)/Turbo.Contracts.dll" Private="false" />
    <Reference Include="$(TurboBin)/Turbo.Primitives.dll" Private="false" />
    <Reference Include="$(TurboBin)/Orleans.Core.Abstractions.dll" Private="false" />
    <Reference Include="$(TurboBin)/Orleans.Serialization.Abstractions.dll" Private="false" />
  </ItemGroup>
  <!-- A host assembly a reference brings along is the host's too: keep every one out of the plugin's folder. -->
  <Target Name="KeepHostAssembliesOut" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="Exists('$(TurboBin)/%(Filename)%(Extension)')"
      />
    </ItemGroup>
  </Target>
</Project>
