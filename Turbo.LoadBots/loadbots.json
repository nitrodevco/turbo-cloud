            "Seed": 1,
            "Personas": {
                "Decorator": 3,
                "Architect": 1,
                "WiredEngineer": 1,
                "GameHost": 1,
                "Visitor": 6
            },
            "ThinkTimeMinMs": 500,
            "ThinkTimeMaxMs": 3000,
            "MaxRoomsPerBot": 3,
            "MaxItemsPerRoom": 80,
            "ReportIntervalSeconds": 10,
            "ReportFile": "loadbots-report-{time}.json"
        }
