{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Bot": "Warning"
        },
        "EventLog": {
            "LogLevel": {
                "Default": "None"
            }
        }
    },
    "LoadBots": {
        "Host": "127.0.0.1",
        "Port": 30000,
