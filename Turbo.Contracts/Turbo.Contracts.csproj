<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- TurboPlugin takes its manifest from the plugin host. -->
    <InternalsVisibleTo Include="Turbo.Plugins" />
    <!-- A run that waited on an approval names its conversation's owner again. -->
    <InternalsVisibleTo Include="Turbo.Ai" />
    <!-- The hotel API (Hotel/) speaks in the primitives' ids, messages and composers. -->
    <ProjectReference Include="..\Turbo.Primitives\Turbo.Primitives.csproj" />
  </ItemGroup>
</Project>
