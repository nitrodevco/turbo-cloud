<Project>
  <!--
    The plugin SDK the server compiles plugins with, beside its own assemblies in plugin-sdk/
    (docs/plugin-loading.md):
      ref/          the framework's reference assemblies (.NET and ASP.NET Core) the server builds
                    against, which a server running on the runtime alone does not have;
      generators/   the source generators pinned with the server (Turbo.Plugins/Compilation/PluginGenerators.cs);
      Turbo.Plugin.props   what a plugin's own project imports to build as the server compiles it
                    (the policy analyzer, Turbo.Plugins.Policy.dll, is beside the server's assemblies);
      ai/           the AI kit for plugin authors, guidelines and skills (docs/turbo-boost.md), so a
                    plugin's `npm run ai` installs the ones of the server it builds against;
      docs/         this server's guides (docs/**/*.md), which the kit points to and the MCP
                    plugin's search_docs searches;
      Turbo.Plugin.Tests.props   what a plugin's test project imports: the test kit (Turbo.Testing,
                    docs/plugin-testing.md), with Turbo.Versions.props, the package versions it needs.
    Imported by the projects that run plugins: Turbo.Main and Turbo.Tests.
  -->
  <Target Name="TurboPluginSdkFiles" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- The targeting packs whole: the server's own build takes some of them from packages. -->
      <_TurboTargetingPack
        Include="@(ResolvedTargetingPack)"
        Condition="'%(Identity)' == 'Microsoft.NETCore.App' or '%(Identity)' == 'Microsoft.AspNetCore.App'"
      />
      <_TurboFrameworkReference Include="%(_TurboTargetingPack.Path)/ref/$(TargetFramework)/*.dll" />
      <_TurboPluginSdkFile
        Include="@(_TurboFrameworkReference)"
        SdkPath="plugin-sdk/ref/%(Filename)%(Extension)"
      />
      <_TurboPluginGenerator
        Include="@(Analyzer)"
        Condition="'%(Filename)' == 'Orleans.CodeGenerator' or '%(Filename)' == 'Microsoft.Extensions.Logging.Generators' or '%(Filename)' == 'System.Text.Json.SourceGeneration' or '%(Filename)' == 'System.Text.RegularExpressions.Generator'"
      />
      <_TurboPluginSdkFile
        Include="@(_TurboPluginGenerator)"
        SdkPath="plugin-sdk/generators/%(Filename)%(Extension)"
      />
      <_TurboPluginSdkFile
        Include="$(MSBuildThisFileDirectory)Turbo.Plugin.props"
        SdkPath="plugin-sdk/Turbo.Plugin.props"
      />
      <_TurboPluginAiFile Include="$(MSBuildThisFileDirectory)../../ai/**/*.md" />
      <_TurboPluginSdkFile
        Include="@(_TurboPluginAiFile)"
        SdkPath="plugin-sdk/ai/%(RecursiveDir)%(Filename)%(Extension)"
      />
      <!-- docs/client/ is nitro-next's guides, copied in by docs-site's build: not this server's. -->
      <_TurboPluginDoc
        Include="$(MSBuildThisFileDirectory)../../docs/**/*.md"
        Exclude="$(MSBuildThisFileDirectory)../../docs/**/bin/**;$(MSBuildThisFileDirectory)../../docs/**/obj/**;$(MSBuildThisFileDirectory)../../docs/**/node_modules/**;$(MSBuildThisFileDirectory)../../docs/client/**"
      />
      <_TurboPluginSdkFile
        Include="@(_TurboPluginDoc)"
        SdkPath="plugin-sdk/docs/%(RecursiveDir)%(Filename)%(Extension)"
      />
      <_TurboPluginSdkFile
        Include="$(MSBuildThisFileDirectory)Turbo.Plugin.Tests.props"
        SdkPath="plugin-sdk/Turbo.Plugin.Tests.props"
      />
      <_TurboSqliteVersion
        Include="@(PackageVersion)"
        Condition="'%(Identity)' == 'Microsoft.EntityFrameworkCore.Sqlite'"
      />
    </ItemGroup>
    <PropertyGroup>
      <_TurboVersionsProps>$(IntermediateOutputPath)Turbo.Versions.props</_TurboVersionsProps>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_TurboVersionsProps)"
      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;TurboSqliteVersion&gt;%(_TurboSqliteVersion.Version)&lt;/TurboSqliteVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <_TurboPluginSdkFile
        Include="$(_TurboVersionsProps)"
        SdkPath="plugin-sdk/Turbo.Versions.props"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="CopyTurboPluginSdk"
    AfterTargets="CopyFilesToOutputDirectory"
    DependsOnTargets="TurboPluginSdkFiles"
  >
    <Copy
      SourceFiles="@(_TurboPluginSdkFile)"
      DestinationFiles="@(_TurboPluginSdkFile->'$(OutDir)%(SdkPath)')"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target
    Name="PublishTurboPluginSdk"
    AfterTargets="ComputeResolvedFilesToPublishList"
    DependsOnTargets="TurboPluginSdkFiles"
  >
    <ItemGroup>
      <ResolvedFileToPublish
        Include="@(_TurboPluginSdkFile)"
        RelativePath="%(_TurboPluginSdkFile.SdkPath)"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
</Project>
