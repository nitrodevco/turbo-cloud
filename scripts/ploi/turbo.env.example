# Turbo settings for a Ploi site. Paste into the site's "Environment" tab (saved as .env in the
# site directory, which git ignores). Remove a line, or leave it commented out, to keep the value
# from appsettings.json / appsettings.Production.json.

TURBO_ENVIRONMENT=Production

# --- Database (Ploi > Server > Databases) ---
TURBO_DB_HOST=127.0.0.1
TURBO_DB_PORT=3306
TURBO_DB_DATABASE=turbo
TURBO_DB_USERNAME=turbo
TURBO_DB_PASSWORD="change-me"
# Or give the whole connection string instead of the parts above:
# TURBO_DB_CONNECTION_STRING="server=127.0.0.1;port=3306;user=turbo;password=secret;database=turbo"
TURBO_DB_LOGGING=false
# Migrations (docs/database.md). The deploy applies them before it restarts Turbo, and the
# server applies any that are left when it starts. Auto: apply what is pending. Check: refuse
# to start while anything is pending. Off: do not look at the schema.
# TURBO_DB_MIGRATE=Auto
# A migration that drops a table or a column is refused on a database that has data. Back up,
# then set this to true for one deploy.
# TURBO_DB_ALLOW_DESTRUCTIVE_MIGRATIONS=false
# How long a migration waits for another one (a second Turbo, a deploy) to finish.
# TURBO_DB_MIGRATION_LOCK_SECONDS=60
# The database server, such as "mysql 8.4.0" or "mariadb 11.4.0", instead of asking it.
# TURBO_DB_SERVER_VERSION=

# --- WebSocket server (what the Nitro client connects to) ---
# Behind the Ploi site's nginx (recommended, gives wss://): listen on loopback only and proxy
# to this port, see scripts/ploi/nginx-websocket.conf.
# Direct, without nginx (plain ws://): set TURBO_WS_HOST=0.0.0.0 and open the port in Ploi's
# firewall.
TURBO_WS_HOST=127.0.0.1
TURBO_WS_PORT=9001

# --- TCP server (Flash/Shockwave-style clients). Nitro connects over WebSocket only, so it is
# off; set TURBO_TCP_ENABLED=true (and keep it on loopback) if you use such a client. ---
TURBO_TCP_ENABLED=false
TURBO_TCP_HOST=127.0.0.1
TURBO_TCP_PORT=30000

# --- Orleans silo. These ports are internal; do not open them in the firewall. ---
TURBO_SILO_ADDRESS=127.0.0.1
TURBO_SILO_PORT=11111
TURBO_GATEWAY_PORT=3000

# --- Packet encryption keys. Generate your own for production. ---
# TURBO_CRYPTO_PUBLIC_KEY=
# TURBO_CRYPTO_PRIVATE_KEY=
# TURBO_CRYPTO_ENCRYPTION=true

# --- Achievements ---
# Where the client loads badge images from (the client's badge.asset.url). Enabled achievements
# are only installed once their badge image is found here.
TURBO_BADGE_ASSET_URL=https://images.nitrodev.co/images/badges/%badgename%.gif

# --- The hotel's owner ---
# Who becomes the owner (the admin group, plus permissions.superuser) when they sign up, or at
# startup if they already have. Name one of these. With the admin panel on, the server log then
# prints the owner's panel setup link. A name can be taken by whoever signs up first, so on a
# public hotel use the Discord id, or set TURBO_WEB_REGISTRATION_OPEN=false until you have signed
# up.
# TURBO_OWNER_DISCORD_ID=123456789012345678
# TURBO_OWNER_NAME=YourName

# --- Admin panel (the turbo-admin site; see its README) ---
# The panel's own address, on its own subdomain. Passkeys are bound to this domain and setup
# links point here.
# TURBO_ADMIN_ENABLED=true
# TURBO_ADMIN_PANEL_URL=https://admin.example.com
# Where the API listens; the panel's nginx proxies /api here. Keep it on loopback.
# TURBO_ADMIN_URL=http://127.0.0.1:8090
# The client's login address, {ticket} where a login ticket goes: the panel hands out login
# links, and draws an image address in the external variables that names no host under it.
# TURBO_ADMIN_CLIENT_LOGIN_URL=https://play.example.com/client?sso={ticket}

# --- Public site (the turbo-web site; see docs/public-site.md) ---
# People sign in with Discord, choose a name the first time, and play in the page.
# TURBO_WEB_ENABLED=true
# TURBO_WEB_SITE_URL=https://example.com
# TURBO_WEB_HOTEL_NAME=Turbo
# The client, on its own subdomain, with {ticket} where the login ticket goes.
# TURBO_WEB_CLIENT_URL=https://play.example.com/?sso={ticket}
# TURBO_WEB_AVATAR_IMAGE_URL=https://imager.example.com/?figure={figure}&size=l
# TURBO_WEB_REGISTRATION_OPEN=true
# The Discord application; its redirect is https://example.com/api/auth/discord/callback.
# TURBO_DISCORD_CLIENT_ID=
# TURBO_DISCORD_CLIENT_SECRET=
# Where the API listens; the site's nginx proxies /api here. Keep it on loopback.
# TURBO_WEB_URL=http://127.0.0.1:8092

# --- Gamedata (docs/gamedata.md) ---
# The files the client loads (furnidata, texts, product and figure data), served under /gamedata/
# on a site whose nginx proxies there; see scripts/ploi/nginx-gamedata.conf.
# TURBO_GAMEDATA_ENABLED=true
# Where clients reach the files, without /gamedata. The /gamedata/hashes list is built on it.
# TURBO_GAMEDATA_PUBLIC_URL=https://example.com
# Where the host listens; the site's nginx proxies /gamedata/ here. Keep it on loopback.
# TURBO_GAMEDATA_URL=http://127.0.0.1:8094
# The Habbo hotel updates come from, and how often it is checked (0: only when staff ask).
# TURBO_GAMEDATA_HABBO_DOMAIN=com
# TURBO_GAMEDATA_RELEASE_CHECK_MINUTES=30

# --- Logging ---
TURBO_LOG_LEVEL=Information
TURBO_LOG_COLOR=false

# --- Deploy ---
# Releases kept in .deploy/releases for a manual rollback.
TURBO_KEEP_RELEASES=5
# Seconds to wait for the old process to stop and the new one to start listening.
TURBO_STOP_TIMEOUT=60
TURBO_START_TIMEOUT=120
# Plugins folder, kept outside the release folders. Defaults to .deploy/shared/plugins.
# TURBO_PLUGIN_PATH=/home/ploi/turbo-plugins
TURBO_PLUGIN_HOT_RELOAD=false
