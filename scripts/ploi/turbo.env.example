# Turbo settings for a Ploi site. Paste into the site's "Environment" tab (saved as .env in the
# site directory, which git ignores). Remove a line, or leave it commented out, to keep the value
# from appsettings.json / appsettings.Production.json.

TURBO_ENVIRONMENT=Production

# --- Database (Ploi > Server > Databases) ---
TURBO_DB_HOST=127.0.0.1
TURBO_DB_PORT=3306
TURBO_DB_DATABASE=turbo
TURBO_DB_USERNAME=turbo
TURBO_DB_PASSWORD="change-me"
# Or give the whole connection string instead of the parts above:
# TURBO_DB_CONNECTION_STRING="server=127.0.0.1;port=3306;user=turbo;password=secret;database=turbo"
TURBO_DB_LOGGING=false

# --- WebSocket server (what the Nitro client connects to) ---
# Behind the Ploi site's nginx (recommended, gives wss://): listen on loopback only and proxy
# to this port, see scripts/ploi/nginx-websocket.conf.
# Direct, without nginx (plain ws://): set TURBO_WS_HOST=0.0.0.0 and open the port in Ploi's
# firewall.
TURBO_WS_HOST=127.0.0.1
TURBO_WS_PORT=9001

# --- TCP server (Flash/Shockwave-style clients). Keep on loopback unless you use one. ---
TURBO_TCP_HOST=127.0.0.1
TURBO_TCP_PORT=30000

# --- Orleans silo. These ports are internal; do not open them in the firewall. ---
TURBO_SILO_ADDRESS=127.0.0.1
TURBO_SILO_PORT=11111
TURBO_GATEWAY_PORT=3000

# --- Packet encryption keys. Generate your own for production. ---
# TURBO_CRYPTO_PUBLIC_KEY=
# TURBO_CRYPTO_PRIVATE_KEY=
# TURBO_CRYPTO_ENCRYPTION=true

# --- Logging ---
TURBO_LOG_LEVEL=Information
TURBO_LOG_COLOR=false

# --- Deploy ---
# Releases kept in .deploy/releases for a manual rollback.
TURBO_KEEP_RELEASES=5
# Seconds to wait for the old process to stop and the new one to start listening.
TURBO_STOP_TIMEOUT=60
TURBO_START_TIMEOUT=120
# Plugins folder, kept outside the release folders. Defaults to .deploy/shared/plugins.
# TURBO_PLUGIN_PATH=/home/ploi/turbo-plugins
TURBO_PLUGIN_HOT_RELOAD=false
