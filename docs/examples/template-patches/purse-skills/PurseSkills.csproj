<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The example add-on plugin, built against this checkout:
      dotnet build docs/examples/template-patches/purse-skills/PurseSkills.csproj
    plugins folder as plugins/skills/, or name that folder in Turbo:Plugin:DevPluginPaths.
    It is not part of Turbo.Cloud.sln; Turbo.Tests compiles and loads its source
    (TemplatePatchExampleTests), so it keeps working as the server changes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PurseSkills</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SelfContained>false</SelfContained>
    <!-- The plugin folder holds the plugin alone: a host assembly beside it would be a second copy. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host's own assemblies: referenced, never copied beside the plugin. -->
    <ProjectReference
      Include="..\..\..\..\Turbo.Contracts\Turbo.Contracts.csproj"
      Private="false"
    />
    <ProjectReference
      Include="..\..\..\..\Turbo.Primitives\Turbo.Primitives.csproj"
      Private="false"
    />
  </ItemGroup>
  <!--
    A project reference brings the host assemblies it uses along (Turbo.Contracts brings
    Turbo.Primitives); a copy beside the plugin would be a second, incompatible copy of the host's
    types. Keep them out.
  -->
  <Target Name="KeepHostAssembliesOut" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('Turbo.'))"
      />
    </ItemGroup>
  </Target>
</Project>
