<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The plugin policy analyzer: the server runs it on every plugin it compiles, and a plugin's own
    project runs it too (plugin-sdk/Turbo.Plugin.props), so a local build fails as the server's
    compile would. netstandard2.0, as every compiler loads analyzers of it.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <!-- A new rule goes in Unshipped; it moves to Shipped when VERSION goes up. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
