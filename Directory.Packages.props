<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <!--
      Roslyn and its transitives are pinned together so central transitive pinning resolves one
      version: Orleans 10 asks for Microsoft.CodeAnalysis 5.0.0 or later and EF Core 11's
      design-time packages for 5.9.0. 5.12.0 is the compiler SDK 11.0.100 ships, so the plugin
      policy analyzer (Turbo.Plugins.Policy) loads in it, and the server compiles plugins with the
      same C# the SDK builds them with (Turbo.Plugins/Compilation/PluginCompiler.cs).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
    <!--
      EF Core stays on the major the target framework and the MySQL provider share:
      Microting.EntityFrameworkCore.MySql 11.0.0 asks for Relational [11.0.0, 11.0.999].
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <!--
      The abstractions (DependencyInjection, Hosting, Logging, Options, Configuration...) are in
      the .NET 11 shared framework: a package reference to one is pruned (NU1510).
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.Abstractions" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Memory" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Core.Abstractions" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.2" />
    <!-- Pomelo's successor: Pomelo.EntityFrameworkCore.MySql stopped at EF Core 9. -->
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="11.0.0" />
    <PackageVersion Include="SuperSocket.Server" Version="2.1.0" />
    <PackageVersion Include="SuperSocket.Server.Abstractions" Version="2.1.0" />
    <PackageVersion Include="SuperSocket.ProtoBase" Version="2.1.0" />
    <PackageVersion Include="SuperSocket.WebSocket.Server" Version="2.1.0" />
    <PackageVersion Include="Scrutor" Version="6.1.0" />
    <!-- Admin panel passkeys (WebAuthn attestation and assertion checks). -->
    <PackageVersion Include="Fido2" Version="4.3.3" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Publishing asset bundles to FTP/FTPS and SFTP targets. -->
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Test-only. FluentAssertions is held on 7.x: 8.0 moved to a commercial licence, and 7.x is
      the last Apache-2.0 line.
    -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
  </ItemGroup>
</Project>
